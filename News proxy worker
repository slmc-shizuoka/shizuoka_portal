// =============================================
// SHIZUOKA PORTAL — News Proxy Worker
// Google News RSSをCORS対応でJSONに変換して返す
// Cloudflare Dashboardで新規Worker作成後、このコードを貼り付ける
// =============================================

// 取得するRSSフィードのリスト
// Google NewsのRSSはキーワード検索形式で経済・IT・AI記事を絞り込む
const RSS_FEEDS = [
  {
    label: 'ビジネス・経済',
    url: 'https://news.google.com/rss/search?q=経済+ビジネス&hl=ja&gl=JP&ceid=JP:ja',
  },
  {
    label: 'IT・テクノロジー',
    url: 'https://news.google.com/rss/search?q=IT+テクノロジー+DX&hl=ja&gl=JP&ceid=JP:ja',
  },
  {
    label: 'AI',
    url: 'https://news.google.com/rss/search?q=AI+人工知能+生成AI&hl=ja&gl=JP&ceid=JP:ja',
  },
];

// 1フィードあたり取得件数
const ITEMS_PER_FEED = 5;

// キャッシュ有効期限(秒): 15分
const CACHE_TTL = 900;

export default {
  async fetch(request, env, ctx) {
    // CORS設定: Vercelのポータルからのリクエストを許可
    const corsHeaders = {
      'Access-Control-Allow-Origin': '*',
      'Access-Control-Allow-Methods': 'GET',
      'Content-Type': 'application/json; charset=utf-8',
      'Cache-Control': `public, max-age=${CACHE_TTL}`,
    };

    // キャッシュから取得を試みる
    const cache = caches.default;
    const cacheKey = new Request(request.url);
    const cached = await cache.match(cacheKey);
    if (cached) return cached;

    try {
      // 全フィードを並行取得
      const results = await Promise.allSettled(
        RSS_FEEDS.map(async (feed) => {
          const res = await fetch(feed.url, {
            headers: { 'User-Agent': 'Mozilla/5.0' },
          });
          const xml = await res.text();
          return { label: feed.label, xml };
        })
      );

      // XMLをパースしてニュースアイテムを抽出
      const items = [];
      for (const result of results) {
        if (result.status !== 'fulfilled') continue;
        const { label, xml } = result.value;

        // <item>タグを正規表現で抽出(Cloudflare WorkersにはDOM parserがないため)
        const itemMatches = xml.matchAll(/<item>([\s\S]*?)<\/item>/g);
        let count = 0;

        for (const match of itemMatches) {
          if (count >= ITEMS_PER_FEED) break;
          const block = match[1];

          const title = extractTag(block, 'title')
            .replace(/<!\[CDATA\[|\]\]>/g, '')
            .trim();
          const link = extractTag(block, 'link').trim();
          const pubDate = extractTag(block, 'pubDate').trim();
          const source = extractTag(block, 'source')
            .replace(/<!\[CDATA\[|\]\]>/g, '')
            .trim();

          if (!title || !link) continue;

          items.push({
            category: label,
            title,
            link,
            source,
            pubDate: pubDate ? new Date(pubDate).toLocaleString('ja-JP', {
              timeZone: 'Asia/Tokyo',
              month: 'numeric',
              day: 'numeric',
              hour: '2-digit',
              minute: '2-digit',
            }) : '',
          });
          count++;
        }
      }

      const json = JSON.stringify({ ok: true, items, updatedAt: new Date().toISOString() });
      const response = new Response(json, { headers: corsHeaders });

      // Cloudflareのエッジキャッシュに保存
      ctx.waitUntil(cache.put(cacheKey, response.clone()));
      return response;

    } catch (err) {
      return new Response(
        JSON.stringify({ ok: false, error: err.message }),
        { status: 500, headers: corsHeaders }
      );
    }
  },
};

// XMLタグの値を取得するヘルパー
function extractTag(xml, tag) {
  const match = xml.match(new RegExp(`<${tag}[^>]*>([\\s\\S]*?)<\/${tag}>`));
  return match ? match[1] : '';
}
